# --- Общие ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://avito:avito@localhost:5432/avito
REDIS_URL=redis://localhost:6379/0

# --- LLM (litellm; по умолчанию DeepSeek) ---
LLM_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Прокси: пул, ротация, healthcheck ---
# PROXY_LIST — список через запятую/перенос строки. Форматы:
#   http://user:pass@host:port, socks5://host:port, host:port:user:pass, host:port
# Ротационные прокси (один endpoint, меняющий IP) — как одна запись.
PROXY_ENABLED=false
PROXY_URL=
PROXY_LIST=
# round_robin | random
PROXY_ROTATION=round_robin
# После N ошибок прокси уходит в кулдаун
PROXY_MAX_FAILURES=3
PROXY_COOLDOWN_SECONDS=300
PROXY_HEALTHCHECK_ENABLED=true
PROXY_HEALTHCHECK_URL=https://api.ipify.org?format=json
PROXY_HEALTHCHECK_INTERVAL_MINUTES=15
CRAWL_RATE_PER_MINUTE=12
CRAWL_MAX_PAGES_PER_RUN=10
# auto | browser | hybrid | http (auto = браузер при установленном patchright)
CRAWL_TRANSPORT=auto
CRAWL_DELAY_MIN_SECONDS=8
CRAWL_DELAY_MAX_SECONDS=20
# Для запуска браузера в контейнере (Docker) поставьте true
BROWSER_NO_SANDBOX=false
# Level 2: полный Chromium и постоянный профиль (живые cookies после browser-login)
BROWSER_HEADLESS=true
BROWSER_CHANNEL=chromium
# Пример: .browser-profile (для ноутбука) или /data/browser-profile (в Docker)
BROWSER_USER_DATA_DIR=

# --- Правила репрайсинга (фаза 6) ---
# Human-in-the-loop: подтверждение оператора при изменении цены больше порога, %
REPRICE_HITL_THRESHOLD_PCT=10
# Максимальный шаг изменения цены за одну операцию, %
REPRICE_MAX_STEP_PCT=5

# --- Умная фильтрация выдачи (AI-модерация) ---
MODERATION_ENABLED=true
# AI-скоринг подозрительных карточек через DeepSeek (батчами, с лимитом)
MODERATION_AI_ENABLED=true
# Ниже какой доли медианы цена считается аномальной
MODERATION_LOW_PRICE_RATIO=0.35
# Сколько одинаковых пар «название+цена» разных продавцов считать дублями
MODERATION_DUPLICATE_MIN_CLUSTER=5
# Батч и лимит AI-запросов за один обход (контроль стоимости)
MODERATION_AI_BATCH_SIZE=10
MODERATION_MAX_AI_ITEMS=40
# Догрузка описаний для подозрительных (страницы объявлений, с паузами)
MODERATION_DESCRIPTIONS_ENABLED=true
MODERATION_DESCRIPTION_MAX_ITEMS=10
MODERATION_DESCRIPTION_DELAY_MIN_SECONDS=3
MODERATION_DESCRIPTION_DELAY_MAX_SECONDS=6

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
