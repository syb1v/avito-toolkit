# --- Общие ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://avito:avito@localhost:5432/avito
REDIS_URL=redis://localhost:6379/0

# --- LLM (litellm; по умолчанию DeepSeek) ---
LLM_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Сбор данных (конкурентная разведка) ---
# Прокси выключены для тестов; включить после подключения провайдера.
PROXY_ENABLED=false
PROXY_URL=
CRAWL_RATE_PER_MINUTE=12
CRAWL_MAX_PAGES_PER_RUN=20
CRAWL_DELAY_MIN_SECONDS=5
CRAWL_DELAY_MAX_SECONDS=15
# Для запуска браузера в контейнере (Docker) поставьте true
BROWSER_NO_SANDBOX=false

# --- Правила репрайсинга (фаза 6) ---
# Human-in-the-loop: подтверждение оператора при изменении цены больше порога, %
REPRICE_HITL_THRESHOLD_PCT=10
# Максимальный шаг изменения цены за одну операцию, %
REPRICE_MAX_STEP_PCT=5

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
